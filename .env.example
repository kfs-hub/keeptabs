# =============================================================================
# KEEP TABS - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key - ONLY used in server-side scripts (seed, migrations)
# NEVER expose this client-side
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# Razorpay
# -----------------------------------------------------------------------------
# Found in: Razorpay Dashboard → Settings → API Keys
# Use rzp_test_* keys for development/testing
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Secret key - NEVER put this in NEXT_PUBLIC_* or any client-side code
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Webhook secret - Found in Razorpay Dashboard → Webhooks → your webhook
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Your deployment URL (used for Razorpay webhook registration)
NEXT_PUBLIC_APP_URL=http://localhost:3000
